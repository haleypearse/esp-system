#pragma once

// Copy this file to secrets.h and fill in the values.
// Do not commit secrets.h to Git.

#define WIFI_SSID "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"

// Browser firmware-upload credentials.
// These are HTTP Basic Auth credentials; keep the management port LAN-only.
#define OTA_USERNAME "admin"
#define OTA_PASSWORD "change-this-password"

// Leave empty for no device-pull update checks.
// For example:
// #define UPDATE_MANIFEST_URL "http://192.168.1.50:8000/manifest.json"
#define UPDATE_MANIFEST_URL ""

// For HTTPS, supply a PEM root CA. Leave empty for HTTP.
#define UPDATE_ROOT_CA ""
